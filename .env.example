# Copy to .env and fill in. .env is gitignored and must never be committed.

# Railway Postgres for this CRM (sign-in accounts and the audit log).
# LOCAL DEV: use the PUBLIC proxy URL from the Postgres service's Variables tab
#   (DATABASE_PUBLIC_URL) — looks like
#   postgresql://postgres:PASSWORD@shinkansen.proxy.rlwy.net:12345/railway
# PRODUCTION: Railway injects DATABASE_URL automatically via a service
#   reference; do not set it by hand there.
DATABASE_URL=

# Signs session cookies. Generate one with:
#   openssl rand -base64 32
# Rotating this logs everyone out.
BETTER_AUTH_SECRET=

# Public origin of the app. Local dev can leave this as-is.
BETTER_AUTH_URL=http://localhost:3000

# The payments service (shubztrader-payments on Railway), where indicator
# subscribers and payments live. The URL is optional: it defaults to
# https://shubztrader-payments-production.up.railway.app
PAYMENTS_API_URL=
# The same value as ADMIN_API_KEY on the payments service (32+ characters).
PAYMENTS_ADMIN_KEY=

# Root superadmin, created or rotated by `npm run setup:superadmin`.
# Keep the password out of the repo — this file is a template; the real values
# live in .env.
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=
